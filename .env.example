# ---------------------------------------------------------------
# 비워 두면 데모 모드로 실행돼요 (메모리 저장, 관리자 비밀번호 admin-demo).
# SUPABASE_URL을 채우면 실제 DB를 쓰고, 아래 값이 모두 필요해요.
# ---------------------------------------------------------------

# Supabase → Project Settings → Data API 의 Project URL
SUPABASE_URL=
# Supabase → Project Settings → API Keys 의 service_role (secret) 키
# 서버에서만 써요. 절대 다른 곳에 공유하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 로그인 쿠키 서명용 (32자 이상 아무 문자열)
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# 공동현관 비밀번호 암호화 키 (32바이트를 base64로). 위와 같은 명령으로 하나 더 만드세요.
# 한 번 정하면 바꾸지 마세요. 바꾸면 저장된 공동현관 비밀번호를 읽을 수 없어요.
DOOR_CODE_KEY=

# 관리자 화면(/admin-login) 비밀번호 (10자 이상)
ADMIN_PASSWORD=

# 고객에게 보여줄 입금 계좌
BANK_ACCOUNT="카카오뱅크 3333-00-0000000 (예금주: 파크리오배터리)"

# ---------------------------------------------------------------
# 알림톡 (선택). 비워 두면 알림을 보내지 않고 관리자 화면에 기록만 남겨요.
# 설정 방법: docs/alimtalk.md
# ---------------------------------------------------------------
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 카카오 채널을 솔라피에 연동하면 생기는 발신 프로필 ID (PF로 시작)
SOLAPI_PFID=
# 솔라피에 등록한 문자 발신번호. 알림톡 실패 시 대체 문자, 운영자 문자에 써요
SOLAPI_SENDER=
# 검수 끝난 템플릿 ID. 예: ORDER_RECEIVED=KA01TP...,PAID=KA01TP...
SOLAPI_TEMPLATES=
# 새 신청·새 문의 문자를 받을 운영자 휴대폰
ADMIN_PHONE=
# 알림에 넣을 앱 주소
APP_URL=https://battery119.vercel.app
