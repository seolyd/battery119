# ---------------------------------------------------------------
# 비워 두면 데모 모드로 실행돼요 (메모리 저장, 데모 로그인 버튼).
# Supabase 값을 채우면 실제 DB와 카카오 로그인을 사용해요.
# ---------------------------------------------------------------

# Supabase 프로젝트 설정 > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 브라우저 코드에서 쓰지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 공동현관 비밀번호 암호화 키 (32바이트를 base64로)
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOOR_CODE_KEY=

# 관리자로 지정할 Supabase 사용자 ID (쉼표로 여러 명)
ADMIN_USER_IDS=

# 고객에게 보여줄 입금 계좌
BANK_ACCOUNT="카카오뱅크 3333-00-0000000 (예금주: 파크리오배터리)"

# 판매가 = 업체 원가 + 이 금액 (모델별 가격을 따로 정하지 않았을 때)
DEFAULT_MARGIN=30000
